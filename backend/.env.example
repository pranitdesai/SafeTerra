# ──────────────────────────────────────────────────
# Kavach — Database
# ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sih
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sih

# ──────────────────────────────────────────────────
# Kavach — Security
# ──────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────────
# Kavach — Application
# ──────────────────────────────────────────────────
APP_NAME=Kavach
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ──────────────────────────────────────────────────
# Kavach — Demo Credentials (seed only — hashed at rest)
# ──────────────────────────────────────────────────
DEMO_ADMIN_EMAIL=admin@kavach.gov.in
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_DDMO_EMAIL=ddmo.dehradun@kavach.gov.in
DEMO_DDMO_PASSWORD=CHANGE_ME
